<Window x:Class="SolarApp.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Довідка — Solar Strategy"
        Height="600" Width="550"
        Background="#FF1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <ScrollViewer Margin="25" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Заголовок -->
            <TextBlock Text="ДОВІДКА" FontSize="28" FontWeight="Bold" Foreground="DodgerBlue" Margin="0,0,0,20"/>

            <!-- Опис програми -->
            <TextBlock Text="ПРО ПРОГРАМУ" FontSize="16" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#CCC" FontSize="13" LineHeight="20" Margin="0,0,0,20">
                Solar Strategy — це програма для оптимізації роботи сонячних панелей 
                з урахуванням географічної локації та погодних умов в Україні. 
                Програма використовує реальні дані з Open-Meteo API для розрахунку 
                прогнозованої кількості енергії.
            </TextBlock>

            <!-- Формула -->
            <TextBlock Text="ФОРМУЛА РОЗРАХУНКУ" FontSize="16" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,8"/>
            <Border Background="#252525" CornerRadius="8" Padding="15" Margin="0,0,0,8">
                <TextBlock TextWrapping="Wrap" Foreground="LimeGreen" FontSize="14" FontFamily="Consolas">
                    E (кВт·год/день) = P(кВт) × H_сон × K_погода × K_орієнтація × K_нахил × K_температура
                </TextBlock>
            </Border>
            <TextBlock TextWrapping="Wrap" Foreground="#CCC" FontSize="13" LineHeight="20" Margin="0,0,0,20">
                Де: P — потужність панелі, H_сон — сонячні години на день,
                K — коефіцієнти впливу різних факторів.
            </TextBlock>

            <!-- Коефіцієнти -->
            <TextBlock Text="КОЕФІЦІЄНТИ" FontSize="16" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#CCC" FontSize="13" LineHeight="22" Margin="0,0,0,20">
                <Bold>Погода:</Bold> Сонячно = 1.0, Змінна хмарність = 0.7, Хмарно = 0.4<LineBreak/>
                <Bold>Орієнтація:</Bold> Південь = 1.0, Схід/Захід = 0.8, Північ = 0.6<LineBreak/>
                <Bold>Нахил:</Bold> Розрахунок через cos(відхилення від оптимального кута)<LineBreak/>
                <Bold>Оптимальний кут:</Bold> широта × 0.76 + 3.1<LineBreak/>
                <Bold>Температура:</Bold> -0.4% за кожен градус вище 25°C
            </TextBlock>

            <!-- Гарячі клавіші -->
            <TextBlock Text="ГАРЯЧІ КЛАВІШІ" FontSize="16" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="F1" FontWeight="Bold" Foreground="Aquamarine" Margin="0,0,20,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Відкрити цю довідку" Foreground="#CCC"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Enter" FontWeight="Bold" Foreground="Aquamarine" Margin="0,0,20,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Застосувати налаштування / Підтвердити" Foreground="#CCC"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Escape" FontWeight="Bold" Foreground="Aquamarine" Margin="0,0,20,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Скасувати / Зняти виділення" Foreground="#CCC"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tab" FontWeight="Bold" Foreground="Aquamarine" Margin="0,0,20,4"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Перехід між полями вводу" Foreground="#CCC"/>
            </Grid>

            <!-- Як користуватися -->
            <TextBlock Text="ЯК КОРИСТУВАТИСЯ" FontSize="16" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#CCC" FontSize="13" LineHeight="22">
                1. Натисніть на сонячну панель на карті для перегляду даних<LineBreak/>
                2. Змініть потужність, кут нахилу або орієнтацію<LineBreak/>
                3. Натисніть «Застосувати» для перерахунку<LineBreak/>
                4. Додайте нові панелі кнопкою «Додати панель»<LineBreak/>
                5. Експортуйте звіт у файл кнопкою «Експорт звіту»<LineBreak/>
                6. Натисніть «Завершити оптимізацію» для підсумку
            </TextBlock>

            <!-- Автор -->
            <Separator Background="#333" Margin="0,20"/>
            <TextBlock Text="Курсова робота — ДВНЗ «Ужгородський національний університет»"
                       Foreground="#666" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Дисципліна: «Основи програмування та алгоритмічні мови»"
                       Foreground="#666" FontSize="11" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</Window>
